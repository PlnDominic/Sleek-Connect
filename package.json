{
  "name": "sleek-connect",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @sleek/web",
    "dev:mobile": "npm run start --workspace @sleek/mobile",
    "build:web": "npm run build --workspace @sleek/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:start": "supabase start -x studio,imgproxy,mailpit,logflare,vector,edge-runtime,supavisor,realtime,storage-api,postgres-meta",
    "db:reset": "supabase db reset",
    "db:seed:generate": "tsx scripts/generate-seed.ts",
    "db:types": "supabase gen types typescript --local > apps/web/src/lib/supabase/database.types.ts"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "supabase": "^2.121.0",
    "tsx": "^4.23.15"
  }
}
