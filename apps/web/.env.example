# Supabase project used by the storefront (Project Settings → API in the Supabase dashboard).
# For local development, `npm run db:start` from the repo root prints these values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secret key (Project Settings → API keys → Secret keys). Used only by the payment and customer-message
# code. Never prefix it with NEXT_PUBLIC_ and never import it into client code.
SUPABASE_SECRET_KEY=

# Online payment. Leave PAYMENT_PROVIDER empty to keep it switched off (orders are still placed and reserved).
# `test` is a stand-in for automated tests that moves no money; it needs ENABLE_TEST_MODES=true and is refused on Vercel production.
# Leave unset on the live site. Only for local development and the automated tests (test payments, `console` messages).
ENABLE_TEST_MODES=
PAYMENT_PROVIDER=
# `hubtel` takes Mobile Money and cards on Hubtel's checkout page (see docs/HUBTEL.md).
# Secret for payment notifications (any long random string, e.g. `openssl rand -hex 24`). With the test provider it signs
# the simulated notifications; with Hubtel it is turned into the secret in the callback address Hubtel posts to.
PAYMENT_WEBHOOK_SECRET=
# Hubtel (PAYMENT_PROVIDER=hubtel): the API ID and API Key of your Online Checkout integration, and your merchant
# account number (also the POS Sales ID for the status check). Server-only secrets: never prefix with NEXT_PUBLIC_.
HUBTEL_API_ID=
HUBTEL_API_KEY=
HUBTEL_MERCHANT_ACCOUNT=
# Optional: HUBTEL_CARD=off hides card payment; HUBTEL_SKIP_STATUS_CHECK=true accepts Hubtel's callback without asking
# Hubtel's status API (weaker; only if your host has no fixed IP address to give Hubtel); HUBTEL_INITIATE_URL and
# HUBTEL_STATUS_URL override Hubtel's addresses.
HUBTEL_CARD=
HUBTEL_SKIP_STATUS_CHECK=
HUBTEL_INITIATE_URL=
HUBTEL_STATUS_URL=

# Customer messages (order confirmed, out for delivery…). Empty = not sent (recorded as such). `console` writes them to
# the server log for development and is ignored on Vercel production.
SMS_PROVIDER=
EMAIL_PROVIDER=
# Email through Gmail (EMAIL_PROVIDER=gmail). GMAIL_APP_PASSWORD is an App Password from Google Account → Security →
# 2-Step Verification → App passwords, never the account's normal password. EMAIL_FROM_NAME is the sender name people see.
# EMAIL_REPLY_TO is where replies go. STORE_ALERT_EMAIL gets a copy of every order event (no delivery codes).
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=Sleek Connect Store
EMAIL_REPLY_TO=
STORE_ALERT_EMAIL=
# Push notifications to the mobile app: `expo` sends through Expo's push service, `console` logs them. Empty = off.
# EXPO_ACCESS_TOKEN is only needed if you turn on "enhanced push security" in your Expo account.
PUSH_PROVIDER=
EXPO_ACCESS_TOKEN=
# Error reports (Sentry) and visit statistics (PostHog); each is off until its key is set. Both keys are meant to be public
# (they go to the browser): everything sent is scrubbed first (see docs/SENTRY_POSTHOG.md). NEXT_PUBLIC_POSTHOG_REGION is
# `us` (default) or `eu`. To upload source maps at build time also set SENTRY_AUTH_TOKEN (secret), SENTRY_ORG, SENTRY_PROJECT.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_REGION=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# Public address of the store, used for links in messages, the sitemap and canonical links (e.g. https://your-domain).
SITE_URL=
# Protects GET /api/notifications/dispatch (retries failed messages); send it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# Company details shown in the terms of service and privacy notice. Leave any of them empty and the sentence that
# needs it is left out.
BUSINESS_NAME=
BUSINESS_REGISTRATION_NUMBER=
BUSINESS_ADDRESS=
DATA_PROTECTION_REGISTRATION_NUMBER=
# Tax identification number: printed on receipts. VAT/GRA invoice rules may need more; ask your accountant.
BUSINESS_TIN=
PAYMENT_PROVIDER_NAME=

# Google Tag Manager container, loaded only after a visitor accepts the visit-statistics prompt and never on private pages.
# Leave unset to use the store's container, or set it empty to switch Tag Manager off.
NEXT_PUBLIC_GTM_ID=GTM-PLSFL8ZJ
