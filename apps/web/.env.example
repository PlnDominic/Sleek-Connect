# Supabase project used by the storefront (Project Settings → API in the Supabase dashboard).
# For local development, `npm run db:start` from the repo root prints these values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secret key (Project Settings → API keys → Secret keys). Used only by the payment code to record
# payments. Never prefix it with NEXT_PUBLIC_ and never import it into client code.
SUPABASE_SECRET_KEY=

# Online payment. Leave PAYMENT_PROVIDER empty to keep it switched off (orders are still placed and reserved).
# `test` is a local stand-in that moves no money; it is refused on Vercel production.
PAYMENT_PROVIDER=
# Signs test-provider webhooks (any long random string, e.g. `openssl rand -hex 24`).
PAYMENT_WEBHOOK_SECRET=
