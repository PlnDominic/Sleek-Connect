# The store's Supabase project (Project Settings → API). Both values are safe to ship in the app: the publishable key
# only reads what row level security allows. Never put the secret key here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The live website, for links that continue on the web (checkout until the app has its own).
EXPO_PUBLIC_SITE_URL=
